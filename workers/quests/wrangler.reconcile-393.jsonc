// Local preservation candidate only. No variable values captured or overridden.
// Existing plain-text vars retained with keep_vars; versions upload retains secrets.
// Global routes/settings/schedules must be verified before any upload or traffic change.
{
  "name": "cambium-quests",
  "main": "src/index.ts",
  "account_id": "9d7cec1b5a32b2df8c6cdc1321ccd00b",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {},
  "kv_namespaces": [
    {
      "binding": "QUESTS",
      "id": "439547e617d9455fb752bfd651da9765"
    },
    {
      "binding": "SECRETS",
      "id": "3ab0824953064453b8a1995a0b4da05e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTEXT_PROJECTIONS",
      "bucket_name": "thoughtseed-context-projections"
    },
    {
      "binding": "THOUGHTSEED_VAULT",
      "bucket_name": "thoughtseed-vault"
    }
  ],
  "vectorize": [
    {
      "binding": "CAMBIUM_CORTEX",
      "index_name": "cambium-cortex"
    },
    {
      "binding": "CAMBIUM_HERMES_RECEIPTS_V2",
      "index_name": "cambium-hermes-receipts-v2"
    }
  ],
  "d1_databases": [
    {
      "binding": "BRIDGE_DB",
      "database_name": "cambium-bridge",
      "database_id": "c0aba88a-5c83-4481-b625-50356d8c98e8",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "HERMES_RECEIPTS_AI"
  }
}
