{
  "name": "cambium-quests",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [],
  "vars": {
    "CONTEXT_ALLOWED_TENANTS": "cambium",
    "CONTEXT_EMBEDDING_PROVIDER": "nvidia",
    "CONTEXT_EMBEDDING_MODEL": "nvidia/nv-embedqa-e5-v5",
    "TF_ACCESS_TEAM_DOMAIN": "red-queen-4dfa.cloudflareaccess.com",
    "TF_ACCESS_AUD": "027d9959d1bab2ffb291b294b2cf49427fe63608a44c228fd05c3c7731ee60d7,5695e8409cd4e838eaaef4de4995541dae4f31a2773945ea67f136800977c200,d3892b5d2a62027029b09b2fd015a9e8074d5efb38c443099f803517cb3feb51",
    "PLEXUS_WHOAMI_URL": "https://plexus-api.thoughtseed.space/v1/whoami"
  },
  "kv_namespaces": [
    { "binding": "QUESTS", "id": "10aaa6e0a8a545c1afb5ceee7ef61c14" }
  ],
  "r2_buckets": [
    { "binding": "THOUGHTSEED_VAULT", "bucket_name": "thoughtseed-vault" }
  ],
  "vectorize": [
    { "binding": "CAMBIUM_CORTEX", "index_name": "cambium-cortex" }
  ],
  "d1_databases": [
    {
      "binding": "BRIDGE_DB",
      "database_name": "cambium-bridge",
      "database_id": "f6b950ac-2480-4a7d-9dac-1ff7e951d936",
      "migrations_dir": "migrations"
    }
  ]
}
