{
  // CF-4 Labs production cutover — curious.thoughtseed.space on Labs
  "name": "cambium-quests",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "account_id": "9d7cec1b5a32b2df8c6cdc1321ccd00b",
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "curious.thoughtseed.space",
      "custom_domain": true
    }
  ],
  "vars": {
    "CONTEXT_ALLOWED_TENANTS": "cambium",
    "MISSION_FABRIC_TENANTS": "cambium",
    "CONTEXT_EMBEDDING_PROVIDER": "nvidia",
    "CONTEXT_EMBEDDING_MODEL": "nvidia/nv-embedqa-e5-v5",
    "COMMAND_CODE_BASE_URL": "https://fd7cth5o4oyqwn6vne76wncxeu0ehmvc.lambda-url.us-east-1.on.aws/provider/v1",
    "TF_ACCESS_TEAM_DOMAIN": "thoughtseedlabs.cloudflareaccess.com",
    "TF_ACCESS_AUD": "dd832e556cd9ee7c4e2fb9fddc6bb16bccd64d1b28b0784f84884a69f8a2f3d9,38b502a01f4063c5521191e084c7fd9b086099c0061b045145cd93165b9af8d0,29e1c8a6760778891fe1278ea0c8639afba1eb41a0008a7fd14850e4168911b5,481fc6643a62b3a4f58778e61b21f571b7039e6357c6e481a4949101f27776fe",
    // Use the direct Worker origin for server-to-server role resolution. The
    // plexus-api custom hostname has its own Access app, which rejects the
    // already-verified curious app JWT before TeamForge can validate it.
    "PLEXUS_WHOAMI_URL": "https://teamforge-api.thoughtseedlabs.workers.dev/v1/whoami"
  },
  "kv_namespaces": [
    { "binding": "QUESTS", "id": "439547e617d9455fb752bfd651da9765" },
    { "binding": "SECRETS", "id": "3ab0824953064453b8a1995a0b4da05e" }
  ],
  "r2_buckets": [
    { "binding": "THOUGHTSEED_VAULT", "bucket_name": "thoughtseed-vault" },
    { "binding": "CONTEXT_PROJECTIONS", "bucket_name": "thoughtseed-context-projections" }
  ],
  "vectorize": [
    { "binding": "CAMBIUM_CORTEX", "index_name": "cambium-cortex" }
  ],
  "d1_databases": [
    {
      "binding": "BRIDGE_DB",
      "database_name": "cambium-bridge",
      "database_id": "c0aba88a-5c83-4481-b625-50356d8c98e8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}
