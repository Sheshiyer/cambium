{
  "manifest_version": 3,
  "name": "Field Report Library — Chrome companion",
  "version": "0.6.2",
  "description": "Field Report Library with an offline Cambium atlas, private sync and native Chrome bookmark and tab-group companion.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "history",
    "bookmarks",
    "favicon",
    "scripting",
    "alarms",
    "tabGroups",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Library"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "command-bar": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Command+K"
      },
      "description": "Open the command bar"
    },
    "open-library": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Library"
    },
    "save-library": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Save page to Library"
    },
    "next-space": {
      "suggested_key": {
        "default": "Alt+Shift+Right",
        "mac": "Alt+Shift+Right"
      },
      "description": "Switch to next native tab group"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "library.html",
  "externally_connectable": {
    "matches": [
      "https://field-report.witnessalchemist.chatgpt.site/*"
    ]
  }
}
