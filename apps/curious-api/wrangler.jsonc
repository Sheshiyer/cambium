      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "CAMBIUM_QUESTS",
      "service": "cambium-quests"
    }
  ]
}
