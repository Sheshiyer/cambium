{
  "name": "@cambium/showreel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic 15s Cambium motion-graphics showreel: three.js engine, headless Brave capture, ffmpeg encode, synthesized audio.",
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target browser --minify",
    "typecheck": "tsc --noEmit",
    "prep": "bun tools/prep-assets.ts",
    "dev": "bun run build && bun tools/serve.ts --dev",
    "render": "bun run build && bun tools/render.ts",
    "render:preview": "bun run build && bun tools/render.ts --preview",
    "audio": "bun tools/audio.ts",
    "mux": "bun tools/mux.ts",
    "verify": "bun tools/verify.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "three": "^0.170"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/three": "^0.170",
    "typescript": "^7.0.2"
  }
}
