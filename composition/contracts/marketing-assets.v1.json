        "product_packet_version": "1.0.0",
        "product_packet_digest": "1111111111111111111111111111111111111111111111111111111111111111",
        "evidence_snapshot_digest": "2222222222222222222222222222222222222222222222222222222222222222",
        "created_at": "2026-07-18T12:00:00.000Z",
        "seed_digest": "3333333333333333333333333333333333333333333333333333333333333333"
      }
    },
