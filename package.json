{
  "name": "cambium",
  "version": "0.3.0",
  "codename": "Urania",
  "private": true,
  "type": "module",
  "description": "The on-brand venture operator: composition contracts, tenant runtime, cortex, and constellation visual engine.",
  "scripts": {
    "test": "node --test 'scripts/*.test.mjs' 'bin/*.test.mjs' 'bin/operator/*.test.ts' 'bin/operator/onboarding/*.test.ts' 'bin/operator/quests/*.test.ts' 'bin/operator/skills/*.test.ts' 'bin/operator/narrative/*.test.ts' 'bin/quine/hyphae/*.test.ts' 'workers/quests/src/*.test.ts' 'workers/quests/src/goal-graph/*.test.ts' 'workers/quests/src/goal-graph-intake.test.ts' 'workers/quests/src/goal-graph-store.test.ts'",
    "operator": "node bin/operator/cli.ts",
    "project:birth": "node scripts/thoughtseed-project-birth.mjs",
    "project:closeout": "node scripts/thoughtseed-project-closeout.mjs",
    "quine": "node bin/quine/quine.ts",
    "plan": "node bin/compose.mjs plan",
    "validate": "node bin/compose.mjs validate",
    "validate:product-branches": "node scripts/validate-product-branch-packets.mjs",
    "validate:portfolio-foundation": "npm run validate:product-branches && node --test scripts/portfolio-foundation-pins.test.mjs scripts/validate-product-branch-packets.test.mjs bin/quine/hyphae/quests.test.ts && pnpm --dir apps/portfolio-cartographer test && node --test workers/quests/src/portfolio-catalog.test.ts workers/quests/src/operating-fabric-portfolio.test.ts workers/quests/src/portfolio-admin-actions.test.ts workers/quests/src/portfolio-workbench-route.test.ts workers/quests/src/mission-fabric.test.ts workers/quests/src/mission-fabric-integration.test.ts",
    "branch-loops:check": "node scripts/branch-loop-library.mjs --tenant cambium --write",
    "demo:tenant": "node scripts/demo-tenant-fixture.mjs",
    "demo:quests": "node scripts/demo-quest-ledger.mjs",
    "tapestry:snapshot": "node scripts/tapestry-snapshot.mjs",
    "render-docs": "node bin/render-docs.mjs",
    "render-docs:refresh": "node bin/render-docs.mjs --refresh-snapshot",
    "render-docs:check": "node bin/render-docs.mjs --check",
    "drift:audit": "node scripts/drift-audit.mjs",
    "audit:text-density": "node scripts/text-density-audit.mjs",
    "retired-runtime:check": "node scripts/retired-runtime-surfaces.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "standalone:audit": "node scripts/standalone-audit.mjs",
    "standalone:smoke": "node scripts/standalone-smoke.mjs",
    "proof:tg-viewport": "node workers/quests/src/visual-viewport-proof.mjs",
    "proof:tg-mobile-contract": "node workers/quests/src/visual-viewport-proof.mjs --mobile-contract",
    "proof:tg-viewport:diagnose": "node workers/quests/src/visual-viewport-proof.mjs --diagnose-browser",
    "visual:capture": "node scripts/visual-regression.mjs",
    "visual:baseline": "node scripts/visual-regression.mjs --mode baseline",
    "proof:tg-live-readiness": "node workers/quests/src/live-proof-readiness.mjs --write",
    "proof:tg-live-readiness:strict": "node workers/quests/src/live-proof-readiness.mjs --write --strict",
    "r3f:dev": "npm --prefix apps/cambium-r3f run dev",
    "r3f:build": "npm --prefix apps/cambium-r3f run build",
    "r3f:test": "npm --prefix apps/cambium-r3f run test",
    "desktop:dev": "npm --prefix apps/cambium-r3f run desktop:dev",
    "desktop:build": "npm --prefix apps/cambium-r3f run desktop:build",
    "desktop:run": "npm --prefix apps/cambium-r3f run desktop:run",
    "desktop:test": "npm --prefix apps/cambium-r3f run desktop:test",
    "desktop:smoke:packaged": "npm --prefix apps/cambium-r3f run desktop:smoke:packaged",
    "desktop:dist:mac:dir": "npm --prefix apps/cambium-r3f run desktop:dist:mac:dir",
    "desktop:dist:mac": "npm --prefix apps/cambium-r3f run desktop:dist:mac",
    "r3f:sync": "npm --prefix apps/cambium-r3f run sync:contracts",
    "r3f:meshy": "npm --prefix apps/cambium-r3f run meshy:assets --",
    "r3f:meshy:image": "npm --prefix apps/cambium-r3f run meshy:image-to-3d --",
    "r3f:source-plates": "npm --prefix apps/cambium-r3f run source-plates --"
  }
}
