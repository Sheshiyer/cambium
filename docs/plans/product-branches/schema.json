{
 "schema_id": "cambium.product_branch_packet.v1",
 "version": 1,
 "description": "Machine-checkable contract for Cambium branch proof packets across product, client, and internal-service branches.",
 "packet_dir": "docs/plans/product-branches",
 "index_file": "docs/plans/product-branches/index.md",
 "required_index_columns": [
  "product_id",
  "canonical_work_id",
  "identity_scope",
  "branch_kind",
  "name",
  "role",
  "promotion_state",
  "current_gate",
  "packet"
 ],
 "required_metadata_fields": [
  "schema",
  "product_id",
  "canonical_work_id",
  "identity_scope",
  "branch_kind",
  "name",
  "role",
  "promotion_state",
  "current_gate",
  "packet_owner"
 ],
 "promotion_states": [
  "proof-only",
  "supervised-branch",
  "autonomous-branch",
  "organ-service"
 ],
 "branch_kinds": [
  "product",
  "client",
  "internal-service"
 ],
 "identity_scopes": [
  "canonical-work-object",
  "template"
 ],
 "non_canonical_work_id_value": "none",
 "non_packet_markdown_files": [
  "ISA.md",
  "index.md",
  "loop-library.md",
  "fitcheck-build-closure.tasks.md",
  "fitcheck-growth-quest-backlog.md"
 ],
 "proof_statuses": [
  "verified",
  "blocked",
  "pending",
  "no-signal"
 ],
 "required_sections": [
  "Product Seed",
  "Organ Routing",
  "Variable Contract Payload",
  "Adapter / Service Map",
  "Evidence Ledger",
  "Gate Ledger",
  "Quest Queue",
  "Loop Control Inputs",
  "Branch Story Controls",
  "Mission Control Inputs",
  "KPI Control Inputs",
  "Policy / Permission Inputs",
  "Dispatch Inputs",
  "Proof Foldback",
  "Promotion Rule"
 ],
 "required_control_tables": [
  {
   "section": "Loop Control Inputs",
   "min_rows": 1,
   "required_columns": [
    "loop_id",
    "title",
    "cadence",
    "objective",
    "metric",
    "boundary_color",
    "one_change_rule",
    "state_file",
    "stop_rule",
    "model_route",
    "proof_required"
   ]
  },
  {
   "section": "Branch Story Controls",
   "min_rows": 6,
   "required_columns": [
    "control",
    "value"
   ],
   "required_control_values": [
    "arc_title",
    "vision",
    "icp",
    "current_frontier",
    "narrative_voice",
    "anti_claims"
   ]
  },
  {
   "section": "Mission Control Inputs",
   "min_rows": 1,
   "required_columns": [
    "mission_id",
    "title",
    "type",
    "owner",
    "gate",
    "proof_required",
    "dispatch_target"
   ]
  },
  {
   "section": "KPI Control Inputs",
   "min_rows": 1,
   "required_columns": [
    "kpi_id",
    "label",
    "survival",
    "better_than_survival",
    "source",
    "current_state"
   ]
  },
  {
   "section": "Policy / Permission Inputs",
   "min_rows": 1,
   "required_columns": [
    "permission",
    "status",
    "required_approval",
    "failure_mode"
   ]
  },
  {
   "section": "Dispatch Inputs",
   "min_rows": 1,
   "required_columns": [
    "route",
    "payload_hint",
    "allowed_when",
    "blocked_when"
   ]
  },
  {
   "section": "Proof Foldback",
   "min_rows": 1,
   "required_columns": [
    "proof_id",
    "source_path",
    "validates",
    "promotes"
   ]
  },
  {
   "section": "Loop Control Inputs",
   "min_rows": 1,
   "required_columns": [
    "loop_id",
    "title",
    "cadence",
    "objective",
    "metric",
    "boundary_color",
    "one_change_rule",
    "state_file",
    "stop_rule",
    "model_route",
    "proof_required"
   ]
  }
 ],
 "provider_data_policy": {
  "section": "Provider / Data Policy",
  "required_columns": [
   "field",
   "value"
  ],
  "allowed_fields": [
   "subgraph_version",
   "stage_capabilities",
   "provider_binding",
   "adapter_version",
   "mutation_enabled",
   "data_classification",
   "processing_region",
   "purpose",
   "retention",
   "suppression_policy"
  ],
  "known_subgraph_versions": [
   "lead-ops@1.0.0"
  ],
  "known_stages": [
   "discover",
   "capture",
   "enrich",
   "understand",
   "create",
   "engage"
  ],
  "data_classifications": [
   "none",
   "synthetic",
   "derived",
   "public_business",
   "business_contact"
  ],
  "caller_override_fields": [
   "tenant",
   "tenant_id",
   "account",
   "account_id",
   "project",
   "project_id",
   "campaign",
   "campaign_id",
   "credential",
   "credential_ref"
  ],
  "zero_authority_defaults": {
   "provider_binding": "none",
   "adapter_version": "none",
   "mutation_enabled": "false"
  }
 },
 "required_branches": [
  {
   "product_id": "fitcheck",
   "canonical_work_id": "sapling:fitcheck",
   "identity_scope": "canonical-work-object",
   "branch_kind": "product",
   "packet": "fitcheck.md"
  },
  {
   "product_id": "vantyx",
   "canonical_work_id": "sapling:vantyx",
   "identity_scope": "canonical-work-object",
   "branch_kind": "product",
   "packet": "vantyx.md"
  },
  {
   "product_id": "snow-gloves-os",
   "canonical_work_id": "program:snow-gloves-os",
   "identity_scope": "canonical-work-object",
   "branch_kind": "internal-service",
   "packet": "snow-gloves-os.md"
  },
  {
   "product_id": "iverif",
   "canonical_work_id": "sapling:iverif",
   "identity_scope": "canonical-work-object",
   "branch_kind": "product",
   "packet": "iverif.md"
  },
  {
   "product_id": "dlock",
   "canonical_work_id": "sapling:dlock",
   "identity_scope": "canonical-work-object",
   "branch_kind": "product",
   "packet": "dlock.md"
  },
  {
   "product_id": "client-delivery",
   "canonical_work_id": "none",
   "identity_scope": "template",
   "branch_kind": "client",
   "packet": "client-delivery.md"
  }
 ],
 "promotion_ladder_phrase": "proof-only -> supervised branch -> autonomous branch"
}
