{
  "schema": "thoughtseed.project-birth-contract.v1",
  "portfolioId": "thoughtseed",
  "status": "founder-approved-local-implementation",
  "pathGrammar": "<projects-root>/thoughtseed/<repository>",
  "activeWorkbenchPortfolios": [
    "thoughtseed"
  ],
  "reviewedSnapshots": {
    "rootMapDigest": "57436877fc82d480eae7eb35adc2bc9149c2a50e22619fb2bb346ee2a2acbe0a",
    "classificationSourceDigest": "43630e6e65dfa78cd5c5e486b389308a8dede9d7bda012b400f4976107cdb309",
    "portfolioCatalogDigest": "sha256:1fcdc4dc690447ebd4bd23e228cd1a306440d8c37d65e6e56ea21e692eeacc24",
    "actionSourceDigest": "43630e6e65dfa78cd5c5e486b389308a8dede9d7bda012b400f4976107cdb309",
    "actionCatalogDigest": "sha256:1fcdc4dc690447ebd4bd23e228cd1a306440d8c37d65e6e56ea21e692eeacc24",
    "pinAuthority": "scripts/portfolio-foundation-pins.mjs",
    "exactMatchRequiredForExecution": true
  },
  "requiredActionDigestFields": [
    "rootMapDigest",
    "sourceDigest",
    "catalogDigest"
  ],
  "founderGateAuthority": {
    "authoritativeStoreKey": "gate:thoughtseed:<receipt-id>",
    "requiredKind": "approve",
    "requiredStatuses": [
      "queued",
      "consumed"
    ],
    "subjectMustEqualIntentDigest": true,
    "inlineReceiptIsAuthority": false,
    "standaloneCliSupportsNonFounderExecution": false,
    "trustedHostResolverRequiredForNonFounderExecution": true
  },
  "requestSources": {
    "local-founder": {
      "initialApproval": "execution-ready"
    },
    "agent": {
      "initialApproval": "founder-gate-pending"
    },
    "rbac": {
      "initialApproval": "founder-gate-pending"
    },
    "dgchat": {
      "initialApproval": "founder-gate-pending"
    },
    "system": {
      "initialApproval": "founder-gate-pending"
    }
  },
  "originGrammar": {
    "thoughtseed-venture": {
      "derivedKind": "sapling",
      "clientFamilyRequired": false,
      "creationAllowed": true
    },
    "thoughtseed-internal": {
      "derivedKind": "internal-program",
      "clientFamilyRequired": false,
      "creationAllowed": true
    },
    "client": {
      "derivedKind": "client-branch",
      "clientFamilyRequired": true,
      "creationAllowed": true
    },
    "unknown": {
      "derivedKind": "needs-review",
      "clientFamilyRequired": false,
      "creationAllowed": false
    }
  },
  "destinationDerivation": {
    "input": "repository slug",
    "relativePath": "thoughtseed/<slug>",
    "callerSuppliedPathAllowed": false,
    "nestingAllowed": false
  },
  "requiredLocalOutputs": [
    "PROJECT.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".project/project.yaml",
    ".project/CONTEXT.md",
    ".project/HANDOFF.md",
    ".project/WORKFLOW.md",
    ".project/project-ingestion-receipt.v1.json",
    ".project/project-index-proposal.v1.json"
  ],
  "workflowMaterialization": {
    "canonicalRegistry": "project-intake-workflows.v1.json",
    "canonicalRegistryUsedByDefault": true,
    "explicitRegistryMustBeAbsoluteRegularFile": true,
    "workflowKindMustMatchOriginDerivedKind": true,
    "defaultWorkflowByKind": {
      "sapling": "sapling-product",
      "client-branch": "client-delivery",
      "internal-program": "internal-capability"
    },
    "workflowDocument": ".project/WORKFLOW.md",
    "stageDirectories": "one safe project-local directory per selected registry stage",
    "receiptFields": [
      "workflowId",
      "workflowDigest",
      "workflowRegistryDigest",
      "workflowStages"
    ],
    "machineLocalRegistryPathCommitted": false
  },
  "indexLink": {
    "currentSnapshot": "portfolio-roots.v1.json",
    "newProjectStatus": "pending-cambium-ingestion",
    "canonicalReconciliationRequired": true,
    "githubPlanningAuthorityRequired": true
  },
  "prohibitedEffects": [
    "physical client-family nesting",
    "automatic GitHub repository creation",
    "automatic portfolio registry mutation",
    "automatic Vault or R2 mutation",
    "automatic Goal Graph mutation",
    "automatic production deployment"
  ]
}
